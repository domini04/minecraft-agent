{
  "name": "minecraft-body",
  "version": "0.1.0",
  "description": "Mineflayer-based execution layer for Minecraft agent",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test:smoke": "node test/smoke/run.js",
    "test:smoke:keep": "node test/smoke/run.js --keep-world",
    "dev:up": "node test/smoke/dev-up.js",
    "dev:down": "node test/smoke/dev-up.js --down"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^4.21.0",
    "mineflayer": "^4.20.1",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
