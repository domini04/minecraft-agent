{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mine",
  "description": "Mines `count` blocks of `target` type within `max_distance` blocks of the bot.",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "max_distance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    }
  },
  "required": ["target", "count"],
  "additionalProperties": false
}
