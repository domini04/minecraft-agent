{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chat",
  "description": "Sends a chat message in-game.",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": ["message"],
  "additionalProperties": false
}
